# Copy this file to .env and fill in the username and password. Never commit .env.
#   Mac / Linux:  cp .env.example .env
#   Windows:      Copy-Item .env.example .env
# Leave DATABASE_URL unset (or delete .env) to use the local SQLite file instead.
DATABASE_URL=postgresql+psycopg://USERNAME:PASSWORD@t2capstonedatabaseserver.postgres.database.azure.com:5432/chudstone?sslmode=require

# Signs the session cookie that remembers the chosen persona. Any long random string, e.g.
#   python -c "import secrets; print(secrets.token_urlsafe(32))"
# If unset a random one is made each time the server starts (everyone gets signed out on restart).
SESSION_SECRET=
